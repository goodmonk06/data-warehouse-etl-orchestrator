generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DataSource {
  id              String           @id @default(uuid())
  name            String
  type            String           // postgres, api, csv, mysql, mongodb, s3
  configJson      Json             // connection details, credentials, etc.
  description     String?
  tags            String[]         @default([])
  isActive        Boolean          @default(true)
  lastTestedAt    DateTime?
  lastTestStatus  String?          // success, failed
  metadata        Json?            // custom metadata
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  pipelines       Pipeline[]
  connectionTests ConnectionTest[]

  @@map("data_sources")
  @@index([type])
  @@index([isActive])
}

model DataTarget {
  id              String           @id @default(uuid())
  name            String
  type            String           // duckdb, postgres, bigquery, snowflake
  configJson      Json             // table name, schema, etc.
  description     String?
  tags            String[]         @default([])
  isActive        Boolean          @default(true)
  lastTestedAt    DateTime?
  lastTestStatus  String?          // success, failed
  metadata        Json?            // custom metadata
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  pipelines       Pipeline[]
  connectionTests ConnectionTest[]

  @@map("data_targets")
  @@index([type])
  @@index([isActive])
}

model Pipeline {
  id                   String                     @id @default(uuid())
  name                 String
  description          String?
  sourceId             String
  targetId             String
  transformScriptPath  String?                    // path to JS/TS transform function
  transformTemplateId  String?                    // reference to transform template
  scheduleCron         String?                    // cron expression for scheduling
  enabled              Boolean                    @default(true)
  tags                 String[]                   @default([])
  priority             Int                        @default(0)
  retryPolicy          Json?                      // retry configuration
  timeoutSeconds       Int?                       // execution timeout
  metadata             Json?                      // custom metadata
  createdBy            String?                    // user or system that created
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  source               DataSource                 @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  target               DataTarget                 @relation(fields: [targetId], references: [id], onDelete: Cascade)
  transformTemplate    TransformTemplate?         @relation(fields: [transformTemplateId], references: [id], onDelete: SetNull)
  runs                 PipelineRun[]
  scheduleHistory      PipelineScheduleHistory[]
  qualityRules         DataQualityRule[]
  notifications        NotificationConfig[]
  dependencies         PipelineDependency[]       @relation("PipelineDependencies")
  dependents           PipelineDependency[]       @relation("DependentPipelines")

  @@map("pipelines")
  @@index([enabled])
  @@index([sourceId])
  @@index([targetId])
}

model PipelineRun {
  id              String                @id @default(uuid())
  pipelineId      String
  startedAt       DateTime              @default(now())
  finishedAt      DateTime?
  status          String                // running, success, failed, cancelled
  statsJson       Json?                 // rows processed, bytes, etc.
  logPath         String?               // path to log file
  errorMessage    String?               @db.Text
  triggeredBy     String?               // manual, scheduled, api, dependency
  retryCount      Int                   @default(0)
  executionTimeMs Int?                  // execution duration
  dataQualityScore Float?               // overall quality score
  metadata        Json?                 // custom metadata

  pipeline        Pipeline              @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  qualityResults  DataQualityResult[]
  notifications   NotificationLog[]

  @@map("pipeline_runs")
  @@index([pipelineId, startedAt])
  @@index([status])
  @@index([startedAt])
}

model TransformTemplate {
  id            String     @id @default(uuid())
  name          String
  description   String?
  category      String     // cleaning, enrichment, aggregation, validation
  version       String     @default("1.0.0")
  code          String     @db.Text
  parameters    Json?      // parameter schema
  tags          String[]   @default([])
  isPublic      Boolean    @default(false)
  usageCount    Int        @default(0)
  createdBy     String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  pipelines     Pipeline[]

  @@map("transform_templates")
  @@index([category])
  @@index([isPublic])
}

model ConnectionTest {
  id              String     @id @default(uuid())
  sourceId        String?
  targetId        String?
  testType        String     // source, target
  status          String     // success, failed
  responseTimeMs  Int?
  errorMessage    String?    @db.Text
  metadata        Json?
  testedAt        DateTime   @default(now())

  source          DataSource? @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  target          DataTarget? @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@map("connection_tests")
  @@index([sourceId])
  @@index([targetId])
  @@index([testedAt])
}

model DataQualityRule {
  id          String                @id @default(uuid())
  pipelineId  String
  name        String
  ruleType    String                // schema, completeness, uniqueness, range, custom
  config      Json                  // rule configuration
  severity    String                @default("warning") // info, warning, error
  enabled     Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  pipeline    Pipeline              @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  results     DataQualityResult[]

  @@map("data_quality_rules")
  @@index([pipelineId])
  @@index([enabled])
}

model DataQualityResult {
  id          String            @id @default(uuid())
  ruleId      String
  runId       String
  passed      Boolean
  score       Float?
  violations  Int               @default(0)
  details     Json?
  checkedAt   DateTime          @default(now())

  rule        DataQualityRule   @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  run         PipelineRun       @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@map("data_quality_results")
  @@index([ruleId])
  @@index([runId])
}

model PipelineScheduleHistory {
  id              String    @id @default(uuid())
  pipelineId      String
  previousCron    String?
  newCron         String?
  previousEnabled Boolean
  newEnabled      Boolean
  changedBy       String?
  reason          String?
  changedAt       DateTime  @default(now())

  pipeline        Pipeline  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@map("pipeline_schedule_history")
  @@index([pipelineId])
  @@index([changedAt])
}

model NotificationConfig {
  id          String              @id @default(uuid())
  pipelineId  String
  channel     String              // email, slack, webhook, sms
  events      String[]            // pipeline_started, pipeline_completed, pipeline_failed, quality_check_failed
  config      Json                // channel-specific configuration
  enabled     Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  pipeline    Pipeline            @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@map("notification_configs")
  @@index([pipelineId])
  @@index([enabled])
}

model NotificationLog {
  id          String      @id @default(uuid())
  runId       String
  channel     String
  event       String
  status      String      // sent, failed
  message     String?     @db.Text
  errorMessage String?    @db.Text
  sentAt      DateTime    @default(now())

  run         PipelineRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@map("notification_logs")
  @@index([runId])
  @@index([sentAt])
}

model PipelineDependency {
  id                String   @id @default(uuid())
  pipelineId        String
  dependsOnPipelineId String
  dependencyType    String   @default("completion") // completion, success, data_available
  createdAt         DateTime @default(now())

  pipeline          Pipeline @relation("PipelineDependencies", fields: [pipelineId], references: [id], onDelete: Cascade)
  dependsOn         Pipeline @relation("DependentPipelines", fields: [dependsOnPipelineId], references: [id], onDelete: Cascade)

  @@unique([pipelineId, dependsOnPipelineId])
  @@map("pipeline_dependencies")
  @@index([pipelineId])
  @@index([dependsOnPipelineId])
}
